# Copy file này thành .env ở thư mục gốc trước khi triển khai thật.
MYSQL_USER=dorostudy
MYSQL_PASSWORD=change_this_database_password
MYSQL_ROOT_PASSWORD=change_this_root_password
REDIS_PASSWORD=change_this_redis_password

FRONTEND_PORT=5173
FRONTEND_BIND_ADDRESS=127.0.0.1

# Chỉ bật khi website chạy sau HTTPS reverse proxy/domain thật.
SESSION_COOKIE_SECURE=false
SEED_DEMO_DATA=false

# Dùng chung cho Google Sign-In ở frontend và backend.
GOOGLE_CLIENT_ID=135488572257-35omi5v7v3uk6h6ulmvnrk9d8fjmkp5u.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=135488572257-35omi5v7v3uk6h6ulmvnrk9d8fjmkp5u.apps.googleusercontent.com

# PostHog project token (phc_), không dùng Personal API key. Được chèn lúc build frontend.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_ENABLED=true
# Optional native PostHog API survey IDs; feedback still reaches Events without them.
VITE_POSTHOG_REFLECTION_SURVEY_ID=
VITE_POSTHOG_UX_SURVEY_ID=

AI_QUOTA_FREE=15
AI_QUOTA_PREMIUM=50
NUDGE_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dorostudy.local

# GEMINI_API_KEY tiếp tục được đọc từ ai-service/.env và không được copy vào image.
